{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:context_entity_type",
    "cases": [
      {
        "when": ["minecraft:player", "minecraft:mannequin"],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:main_hand",
          "cases": [
            {
              "when": "right",
              "model": {
                "type": "minecraft:select",
                "property": "minecraft:display_context",
                "cases": [
                  {
                    "when": ["thirdperson_lefthand", "firstperson_lefthand"],
                    "model": { "type": "minecraft:empty" }
                  }
                ],
                "fallback": {
                  "type": "minecraft:model",
                  "model": "blackpowder_legacy:item/winchester_1873"
                }
              }
            },
            {
              "when": "left",
              "model": {
                "type": "minecraft:select",
                "property": "minecraft:display_context",
                "cases": [
                  {
                    "when": ["thirdperson_righthand", "firstperson_righthand"],
                    "model": { "type": "minecraft:empty" }
                  }
                ],
                "fallback": {
                  "type": "minecraft:model",
                  "model": "blackpowder_legacy:item/winchester_1873"
                }
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "blackpowder_legacy:item/winchester_1873"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "blackpowder_legacy:item/winchester_1873"
    }
  }
}
